generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  phone               String
  password_hash       String?
  role                String   // 'recipient' | 'donor' | 'hospital' | 'admin'
  profile_image       String?
  verification_status String   @default("Unverified") // 'Unverified' | 'Pending' | 'Verified' | 'Rejected'
  created_at          String
  updated_at          String

  donors              Donor[]
  recipientProfiles   RecipientProfile[]
  bloodRequests       BloodRequest[]
  notifications       Notification[]
  favorites           Favorite[]
  verificationDocs    VerificationDocument[]
  donationHistories   DonationHistory[]
}

model RecipientProfile {
  id              String   @id @default(uuid())
  user_id         String
  patient_name    String
  relationship    String?  // 'Self' | 'Family Member' | 'Friend' | 'Other'
  created_at      String
  updated_at      String

  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model BloodRequestDocument {
  id              String   @id @default(uuid())
  request_id      String
  file_name       String
  file_size       Int
  mime_type       String
  secure_path     String
  uploaded_at     String
}

model VerificationRecord {
  id              String   @id @default(uuid())
  identifier      String   // phone or email
  otp_code        String
  type            String   // 'phone_verification' | 'password_reset'
  attempts        Int      @default(0)
  expires_at      String
  verified        Boolean  @default(false)
  created_at      String
}

model Donor {
  id                    String   @id @default(uuid())
  user_id               String
  name                  String
  email                 String
  phone                 String
  blood_group           String
  date_of_birth         String?
  gender                String?
  city                  String
  area                  String
  pin_code              String
  latitude              Float?
  longitude             Float?
  availability          String   @default("Available") // 'Available' | 'Unavailable' | 'Emergency-Only'
  last_donation_date    String?
  total_donations       Int      @default(0)
  verification_status   String   @default("Unverified")
  rating                Float    @default(5.0)
  review_count          Int      @default(0)
  visibility            String   @default("Public") // 'Public' | 'Hospital_Only' | 'Private'
  emergency_ready       Boolean  @default(true)
  badge_title           String?
  response_rate_percent Int      @default(100)
  avg_response_time     String   @default("15 mins")
  bio                   String?
  updated_at            String

  user                  User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model BloodRequest {
  id                      String   @id @default(uuid())
  requester_id            String
  requester_name          String
  requester_phone         String
  patient_name            String
  blood_group             String
  hospital                String
  city                    String
  quantity_units          Int      @default(1)
  urgency                 String   @default("Standard") // 'Standard' | 'Urgent' | 'Critical'
  status                  String   @default("Open") // 'Open' | 'In_Progress' | 'Fulfilled' | 'Cancelled'
  is_emergency_sos        Boolean  @default(false)
  contact_number          String
  notes                   String?
  prescription_file_name  String?
  prescription_file_url   String?
  created_at              String
  updated_at              String

  requester               User     @relation(fields: [requester_id], references: [id], onDelete: Cascade)
  donorRequests           DonorRequest[]
}

model DonorRequest {
  id                String   @id @default(uuid())
  request_id        String
  donor_id          String
  status            String   @default("Pending") // 'Pending' | 'Accepted' | 'Declined' | 'Completed'
  message           String?
  response_notes    String?
  requested_at      String
  responded_at      String?

  bloodRequest      BloodRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
}

model BloodBank {
  id              String   @id @default(uuid())
  name            String
  city            String
  address         String
  phone           String
  latitude        Float
  longitude       Float
  is_24x7         Boolean  @default(true)
  stock_A_pos     Int      @default(0)
  stock_A_neg     Int      @default(0)
  stock_B_pos     Int      @default(0)
  stock_B_neg     Int      @default(0)
  stock_AB_pos    Int      @default(0)
  stock_AB_neg    Int      @default(0)
  stock_O_pos     Int      @default(0)
  stock_O_neg     Int      @default(0)
  services        String   // comma separated or JSON string
  updated_at      String
}

model Notification {
  id          String   @id @default(uuid())
  user_id     String
  title       String
  message     String
  type        String   @default("info") // 'emergency' | 'request' | 'system' | 'badge' | 'reminder' | 'info'
  read        Boolean  @default(false)
  created_at  String

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Favorite {
  id          String   @id @default(uuid())
  user_id     String
  donor_id    String
  created_at  String

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model VerificationDocument {
  id                    String   @id @default(uuid())
  user_id               String
  donor_id              String
  user_name             String
  document_type         String
  blood_group_claimed   String
  file_name             String
  secure_file_reference String
  status                String   @default("Pending") // 'Pending' | 'Verified' | 'Rejected'
  rejection_reason      String?
  reviewed_by           String?
  created_at            String
  reviewed_at           String?

  user                  User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Achievement {
  id           String   @id @default(uuid())
  title        String
  description  String
  icon         String
  category     String
  criteria     String
}

model DonorAchievement {
  id             String   @id @default(uuid())
  donor_id       String
  achievement_id String
  unlocked_at    String
}

model DonationHistory {
  id               String   @id @default(uuid())
  donor_id         String
  user_id          String
  donation_date    String
  blood_bank_name  String
  units_donated    Int      @default(1)
  donation_type    String   @default("Whole Blood")
  certificate_url  String?

  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  actor_id    String
  actor_name  String
  action      String
  entity_type String
  entity_id   String
  details     String?
  created_at  String
}
